{
  "name": "github-codeowners",
  "version": "0.1.0",
  "description": "GitHub Codeowners Browser Extension",
  "private": true,
  "scripts": {
    "watch": "webpack --mode=development --output-pathinfo --watch --config config/webpack.config.js",
    "build": "rm -rf build && webpack --mode=production --config config/webpack.config.js",
    "pack": "node pack.js",
    "repack": "npm run build && npm run pack",
    "format": "prettier --write --ignore-unknown \"{config,public,browser,core,vscode}/**/*.{html,css,js,ts,json}\"",
    "zip": "npm run repack",
    "vscode:build": "cd vscode && npm run build",
    "vscode:watch": "cd vscode && npm run watch",
    "vscode:package": "cd vscode && npm run package"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.11.0",
    "file-loader": "^6.2.0",
    "mini-css-extract-plugin": "^2.9.1",
    "prettier": "^2.8.8",
    "webpack": "^5.94.0",
    "webpack-cli": "^4.10.0",
    "webpack-merge": "^5.10.0"
  },
  "dependencies": {
    "ignore": "^6.0.2"
  }
}
